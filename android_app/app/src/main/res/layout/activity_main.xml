<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Background Gradient Layer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:background="@drawable/gradient_header"
        android:alpha="0.15" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:gravity="center_horizontal">

            <!-- Logo + Branding Layer -->
            <LinearLayout
                android:id="@+id/logoContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="40dp">

                <!-- Glowing Logo Circle -->
                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp">

                    <!-- Glow Effect -->
                    <View
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:background="@drawable/gradient_purple"
                        android:alpha="0.3" />

                    <!-- Main Logo -->
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:background="@drawable/card_glass"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="@color/primary"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="BLINK ERP"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:letterSpacing="0.3"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="BlinkERP —\nEnterprise Attendance."
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Real BLE Detection. Next-Level ERP."
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Teacher Card - Glassmorphism -->
            <LinearLayout
                android:id="@+id/teacherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:background="@drawable/card_glass"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="24dp">

                <Button
                    android:id="@+id/btnTeacher"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/gradient_purple"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="♧  Teacher"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Start class &amp; BLE advertise to students"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Student Card - Glassmorphism -->
            <LinearLayout
                android:id="@+id/studentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_glass"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="24dp">

                <Button
                    android:id="@+id/btnStudent"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/rounded_button_outline"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="⚡  Student"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Join class &amp; BLE scan for teacher"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Admin Card - Glassmorphism -->
            <LinearLayout
                android:id="@+id/adminCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_glass"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:padding="24dp">

                <Button
                    android:id="@+id/btnAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/rounded_button_outline"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="⚙️  Admin Login"
                    android:textAllCaps="false"
                    android:textColor="#FFB74D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Full ERP control &amp; User management"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Server IP Pill -->
            <TextView
                android:id="@+id/tvServerIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/rounded_button_outline"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="🌐 Server: http://192.168.194.186:5000"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
