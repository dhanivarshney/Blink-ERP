<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Background Gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/gradient_header"
        android:alpha="0.1" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_header"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvPyqTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📝 PYQ Papers"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Previous Year Questions — Click to open in Google Drive"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:alpha="0.8" />
            </LinearLayout>

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvPyqEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="📭 No PYQs yet\n\nUpload from Streamlit Dashboard"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- PYQ Cards Container -->
            <LinearLayout
                android:id="@+id/pyqContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp" />

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Back Button (Overlay) -->
    <Button
        android:id="@+id/btnPyqBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="left|top"
        android:layout_margin="16dp"
        android:background="@drawable/rounded_button_outline"
        android:text="←"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

</FrameLayout>
